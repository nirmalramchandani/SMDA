# ─── Database Connections ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>
POSTGRES_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ─── Crash Alert Notifications (Optional) ─────────────────────────────
# Configure one or both channels to receive alerts on your personal device.

# --- Email (Gmail SMTP) ---
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an "App Password" for "Mail"
# 3. Use that 16-char password below (NOT your Gmail login password)
ALERT_EMAIL_TO=your-email@gmail.com
ALERT_EMAIL_FROM=your-sender@gmail.com
ALERT_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# --- Telegram Bot ---
# 1. Message @BotFather on Telegram → /newbot → follow steps → get token
# 2. Message @userinfobot on Telegram → get your chat_id
# 3. Start a chat with your bot first (send it /start)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=123456789
